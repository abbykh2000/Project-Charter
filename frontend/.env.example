# Google Sheets public API access used by custom frameworks.
VITE_GOOGLE_SHEETS_API_KEY=

# Backend proxy URL. Do not put Secureframe API credentials in Vite variables.
VITE_SECUREFRAME_PROXY_URL=http://localhost:8787

# Mock signed-in user used until the dashboard is connected to SSO.
VITE_CURRENT_USER_ID=user-compliance-manager

# Optional stale-data threshold.
VITE_STALE_AFTER_HOURS=24
